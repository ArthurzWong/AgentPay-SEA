{
  "name": "agentpay-sea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx server/local.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/local.ts",
    "check": "tsc --noEmit",
    "cli": "node --import tsx cli/agentpay.ts",
    "devnet:wallet": "node scripts/create-devnet-wallet.mjs"
  },
  "bin": {
    "agentpay": "bin/agentpay.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
