# Set DEMO_MODE=false only after funding this key with devnet SOL and devnet USDC.
DEMO_MODE=true
PORT=8787
RPC_URL=https://api.devnet.solana.com
# JSON array of 64 secret-key bytes. Never expose this value to the browser.
SERVER_PRIVATE_KEY=
# Public key of the merchant receiving the USDC payments.
MERCHANT_WALLET=
# Devnet USDC mint. Replace if using a different supported devnet USDC mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Optional; only used for a future natural-language summary layer.
LLM_API_KEY=
# Comma-separated browser origins allowed to call the API. Defaults to the local dev origins / this deployment.
ALLOWED_ORIGINS=
# Shared secret required in the X-API-Key header on POST /api/agent/run. Required whenever DEMO_MODE=false.
AGENT_API_KEY=
# Maximum agent runs allowed per client IP per minute.
RUN_RATE_LIMIT=10
